# Copy to .env for local, or set these in Railway Variables for production.
#
# Live site: https://msme.toyacorp.in
# API:       https://msme-production-3479.up.railway.app
# Login:     https://msme.toyacorp.in/nominate/login

PORT=4000
NODE_ENV=development

# Neon DIRECT host for Express (no "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

CORS_ORIGIN="http://localhost:3000"
# Production: CORS_ORIGIN="https://msme.toyacorp.in"

AUTH_SECRET="change-me-in-production"

# Email via Resend only (required for OTP on register/login)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Mysuru MSME Awards <onboarding@resend.dev>"
# After verifying toyacorp.in on resend.com/domains:
# RESEND_FROM="Mysuru MSME Awards <awards@toyacorp.in>"

# Local only: show demo OTP in API when email fails. Must be false in production.
OTP_DEV_EXPOSE=true

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=15
