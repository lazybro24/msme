# Copy to .env for local, or set these in Railway Variables for production.
#
# Live site: https://msme.toyacorp.in
# API:       https://msme-production-3479.up.railway.app

PORT=4000
NODE_ENV=development

# Neon DIRECT host for Express (no "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Comma-separated. Production must include the real site origin (not only localhost).
CORS_ORIGIN="http://localhost:3000"
# Production: CORS_ORIGIN="https://msme.toyacorp.in"

# --- Required in production (boot fails without these when NODE_ENV=production) ---
# Cloudflare R2 / S3-compatible object storage:
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=msme-awards
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PREFIX=msme

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=15

# --- Email (used) ---
# Resend API — used for notification emails + enquiry alerts
# RESEND_API_KEY=re_...
# SMTP_FROM="Mysuru MSME Awards <noreply@yourdomain.com>"   # Resend "from" address
# MAIL_INBOX=secretariat@yourdomain.com                    # receives public enquiry alerts

# --- Email (reserved / not wired yet) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Do not enable in production ---
# OTP_DEV_EXPOSE=false     # unused today; keep false
# DEMO_USERS_ENABLED=false
# ALLOW_PROD_SEED=false

# --- Optional / ops ---
# AUTH_SECRET=             # unused (sessions are DB bearer tokens)
# SEED_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Awards Admin
# RUN_MIGRATE_ON_START=false
# EVALUATION_DEADLINE_DAYS=21
