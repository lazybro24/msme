# Copy to .env for local, or set these in Railway Variables for production.
#
# === YOUR LAST STEP (hosts) ===
# Railway (backend): set all variables below for Production.
# Vercel (frontend): set NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app
# First admin (pick ONE):
#   A) Set BOOTSTRAP_ADMIN_* below, deploy/start API once, then DELETE BOOTSTRAP_ADMIN_PASSWORD
#   B) Or run: npm run create-admin -- you@domain.com "StrongPass123!" "Admin Name"
# Login: https://YOUR-FRONTEND/3e8e287e2388/login
# Attach a Railway volume at UPLOAD_DIR (e.g. /data/uploads) OR set S3_* for R2/S3.
# If DB was created earlier with db push, once: npx prisma migrate resolve --applied 20260923120000_init

PORT=4000
NODE_ENV=development

# Neon: Dashboard → Project → Connection string (use "pooled" for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Frontend origin (Vercel URL in production)
CORS_ORIGIN="http://localhost:3000"

# Long random string in production (openssl rand -hex 32)
AUTH_SECRET="change-me-in-production"

# One-time first admin (only used when ZERO administrators exist).
# After the API logs "Created ADMINISTRATOR …", remove BOOTSTRAP_ADMIN_PASSWORD.
# BOOTSTRAP_ADMIN_EMAIL=you@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
# BOOTSTRAP_ADMIN_NAME=Awards Administrator

# Required for real welcome / OTP / password-reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Mysuru MSME Awards <noreply@yourdomain.com>"

# MUST be false in production.
OTP_DEV_EXPOSE=false

# Seed (local only). Production seed is blocked unless ALLOW_PROD_SEED=true
# and SEED_PASSWORD is a strong secret (never "demo"). Prefer bootstrap / create-admin.
# SEED_PASSWORD=change-me
# ALLOW_PROD_SEED=false

# Local disk (default). On Railway, mount a volume at this path.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=15

# Optional S3-compatible object storage (AWS S3 or Cloudflare R2).
# S3_BUCKET=msme-uploads
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PREFIX=msme

# Optional
# DEMO_USERS_ENABLED=false
# EVALUATION_DEADLINE_DAYS=14
# MFA_ISSUER=Mysuru MSME Awards
